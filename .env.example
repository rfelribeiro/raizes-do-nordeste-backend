# Modelo de configuração. NÃO coloque segredos reais aqui: este arquivo é versionado.
# `make setup` cria o .env a partir deste modelo e gera uma senha aleatória para o banco.

# Ambiente da aplicação: local | ci | producao
APP_ENV=local
# Nível de log: DEBUG | INFO | WARNING | ERROR
APP_LOG_LEVEL=INFO
# Porta da API publicada no host (http://localhost:<API_PORT>/docs)
API_PORT=8080

# Banco de dados PostgreSQL
POSTGRES_DB=raizes
POSTGRES_USER=raizes
# Valor fictício; é substituído por uma senha aleatória pelo `make setup`.
POSTGRES_PASSWORD=troque_esta_senha_ficticia
# Dentro do compose o host é sobrescrito para "db"; estes valores valem para uso fora do Docker.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Porta do Postgres publicada no host (somente loopback)
DB_HOST_PORT=5432

# --- Data Warehouse (DuckDB + Parquet). Caminhos relativos à raiz do repositório;
# dentro do contêiner `analytics` o compose usa caminhos absolutos em /app/data.
DW_DUCKDB_PATH=data/warehouse/raizes.duckdb
DW_LAKE_PATH=data/lake
# Atraso de segurança da extração da outbox: ignora eventos registrados há menos de N segundos
# (evita pular eventos de transações que confirmam fora de ordem). Padrão: 5.
DW_EXTRACTION_LAG_SECONDS=5
# SEGREDO gerado localmente pelo `make setup` (nunca versionar, nunca compartilhar).
# Chave do HMAC-SHA256 que pseudonimiza o identificador do cliente no analítico.
ANALYTICS_PSEUDONYM_KEY=
